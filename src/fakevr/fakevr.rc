// Version resource: tools\run.ps1 and tools\package.ps1 tell the fake runtime from Valve's
// openvr_api.dll by its ProductName.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hotd-overkill-vr tests"
            VALUE "FileDescription", "fakevr: fake SteamVR runtime for tests (never starts SteamVR)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "fakevr"
            VALUE "OriginalFilename", "openvr_api.dll"
            VALUE "ProductName", "hovr fakevr"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
